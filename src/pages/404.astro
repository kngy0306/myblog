---
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import dog from "@/images/404.jpeg";
---

<Layout title="404 Not Found | kona blog">
  <main class="text-center py-20">
    <Picture
      src={dog}
      formats={["avif", "webp"]}
      fallbackFormat="jpeg"
      widths={[320, 640, 1280]}
      sizes="(min-width: 896px) 612px, (min-width: 640px) calc(75vw - 60px), calc(75vw - 24px)"
      priority
      alt="ページが閲覧できずに悲しい顔をしている犬"
      class="mx-auto w-3/4 h-auto"
    />
    <h1 class="text-2xl font-bold mt-8">404 Not Found</h1>
    <p class="mt-4">お探しのページは見つかりませんでした。</p>
    <a href="/" class="mt-8 inline-block underline">トップページへ戻る</a>
  </main>
</Layout>
