---
// URLからOpen Graphデータを取得してカード形式で表示するコンポーネント
// 使用方法: <LinkCard url="https://example.com" />

import { getOpenGraphData, parseWebUrl } from "@/lib/link-card";

interface Props {
  url: string;
}

const { url } = Astro.props;

const linkUrl = parseWebUrl(url);
if (!linkUrl) throw new Error("LinkCard requires an HTTP(S) URL without credentials");

const websiteData = await getOpenGraphData(linkUrl);
const faviconUrl = new URL("https://www.google.com/s2/favicons");
faviconUrl.search = new URLSearchParams({ sz: "32", domain_url: linkUrl.origin }).toString();
const image = websiteData?.ogImage?.[0]?.url;
const parsedImageUrl = image ? parseWebUrl(image, linkUrl) : null;
const imageUrl = parsedImageUrl?.protocol === "https:" ? parsedImageUrl.href : undefined;
const domain = linkUrl.hostname.replace(/^www\./, "");
const title = websiteData?.ogTitle || websiteData?.ogSiteName || domain;
const description = websiteData?.ogDescription;
const siteName = websiteData?.ogSiteName;
---

<div
  class="not-prose my-6 h-32 rounded-lg overflow-hidden border border-slate-200 bg-background hover:bg-slate-100 shadow-sm transition-colors"
>
  <a href={linkUrl.href} target="_blank" rel="noopener noreferrer" class="flex flex-row h-32">
    <div class="flex min-w-0 flex-1 flex-col justify-center py-1 px-4 wrap-break-word">
      <div class="text-[1rem]/6 font-semibold text-foreground line-clamp-2">{title}</div>
      {description && <div class="mt-1 text-sm text-gray-600 line-clamp-1">{description}</div>}
      <div class="flex flex-row mt-2.5 items-center text-sm text-gray-500">
        <img
          src={faviconUrl}
          alt=""
          referrerpolicy="no-referrer"
          width="16"
          height="16"
          loading="lazy"
          decoding="async"
          class="not-prose h-4 w-4 mr-1"
        />
        {siteName || domain}
      </div>
    </div>
    {
      imageUrl && (
        <div class="relative h-32 w-32 shrink-0">
          <img
            src={imageUrl}
            alt=""
            referrerpolicy="no-referrer"
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
            class="not-prose w-full h-full object-cover"
          />
        </div>
      )
    }
  </a>
</div>
