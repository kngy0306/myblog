---
import { Image } from "astro:assets";
import logoImage from "@/images/logo.svg";

const isHome = Astro.url.pathname === "/" || /^\/\d+\/?$/.test(Astro.url.pathname);
const isAbout = Astro.url.pathname.startsWith("/about");
---

<header class="site-header">
  <nav aria-label="メインナビゲーション">
    <div class="site-header-inner">
      <div>
        <a
          href="/"
          class="site-brand"
        >
          <Image src={logoImage} width={30} height={30} alt="" class="site-logo" />
          <span>こなぶろぐ</span>
        </a>
      </div>

      <div>
        <ul class="site-nav-list">
          <li>
            <a
              href="/"
              class="site-nav-link"
              aria-current={isHome ? "page" : undefined}>Home</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="site-nav-link"
              aria-current={isAbout ? "page" : undefined}
              >About</a
            >
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
